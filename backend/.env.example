# Comma-separated origins allowed to call the API (the Vite dev server by default)
ALLOWED_ORIGINS=http://localhost:5173

# Maximum upload size, in megabytes
MAX_UPLOAD_SIZE_MB=500

# Maximum pasted text length, in characters
MAX_TEXT_LENGTH=200000

# Where uploaded files are saved, relative to the backend folder
UPLOAD_DIR=storage/uploads

# Maximum lecture length, in minutes
MAX_VIDEO_MINUTES=15
MAX_AUDIO_MINUTES=30

# Where videos and audio are kept during processing, relative to the backend folder
TEMP_DIR=temp

# Speech-to-text (faster-whisper)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Lecture notes (create a key in Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used in order when the main model is overloaded or times out (comma-separated, empty to turn off)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
