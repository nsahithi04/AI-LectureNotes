# Base URL of the FastAPI backend.
# 127.0.0.1 rather than localhost: uvicorn listens on IPv4 only, and localhost can resolve to IPv6 first.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Client-side upload size check, in megabytes (keep in sync with the backend's MAX_UPLOAD_SIZE_MB)
VITE_MAX_UPLOAD_SIZE_MB=500

# OAuth client ID for creating Google Forms (Google Cloud Console > APIs & Services > Credentials).
# This ID is public, so it's safe in frontend code. Never put a client secret here.
VITE_GOOGLE_CLIENT_ID=
